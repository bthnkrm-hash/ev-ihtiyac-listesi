import React from "react";
import {
  SafeAreaView,
  ScrollView,
  StyleSheet,
  Text,
  TouchableOpacity,
  View,
} from "react-native";
import { StatusBar } from "expo-status-bar";

import { NavigationContainer } from "@react-navigation/native";
import { createBottomTabNavigator } from "@react-navigation/bottom-tabs";

import { ShoppingProvider, useShopping } from "./store/ShoppingStore";
import AddItemScreen from "./screens/AddItemScreen";

const Tab = createBottomTabNavigator();

const categories = [
  ["🧹", "Temizlik", 42],
  ["🍳", "Mutfak", 58],
  ["🧻", "Kağıt & Hijyen", 24],
  ["🧴", "Kişisel Bakım", 36],
  ["🏠", "Ev & Yaşam", 31],
  ["🐶", "Evcil Hayvan", 27],
  ["👶", "Bebek", 22],
  ["🔧", "Hırdavat", 35],
];

function HomeScreen() {
  const { items } = useShopping();

  const activeItems = items.filter(
    (item) => !item.completed
  );

  return (
    <SafeAreaView style={styles.safe}>
      <StatusBar style="dark" />

      <ScrollView contentContainerStyle={styles.container}>
        <View style={styles.header}>
          <View>
            <Text style={styles.small}>EVİM</Text>

            <Text style={styles.title}>
              Merhaba 👋
            </Text>

            <Text style={styles.subtitle}>
              Bugün evde ne eksik?
            </Text>
          </View>

          <View style={styles.homeIcon}>
            <Text style={{ fontSize: 24 }}>🏠</Text>
          </View>
        </View>

        <View style={styles.summary}>
          <View>
            <Text style={styles.summaryLabel}>
              Alışveriş listem
            </Text>

            <Text style={styles.number}>
              {activeItems.length}
            </Text>

            <Text style={styles.summaryText}>
              ürün alınmayı bekliyor
            </Text>
          </View>

          <Text style={styles.cart}>🛒</Text>
        </View>

        <Text style={styles.sectionTitle}>
          Kategoriler
        </Text>

        <View style={styles.grid}>
          {categories.map(
            ([icon, name, count]) => (
              <TouchableOpacity
                key={name}
                style={styles.category}
              >
                <Text style={styles.categoryIcon}>
                  {icon}
                </Text>

                <Text style={styles.categoryName}>
                  {name}
                </Text>

                <Text style={styles.count}>
                  {count} ürün
                </Text>
              </TouchableOpacity>
            )
          )}
        </View>

        <View style={styles.listHeader}>
          <Text style={styles.sectionTitle}>
            Alışveriş listem
          </Text>

          <Text style={styles.seeAll}>
            {activeItems.length} ürün
          </Text>
        </View>

        <View style={styles.list}>
          {activeItems.length === 0 ? (
            <Text style={styles.empty}>
              Listen şimdilik boş 🎉
            </Text>
          ) : (
            activeItems.map((item) => (
              <View
                style={styles.row}
                key={item.id}
              >
                <View style={styles.checkbox} />

                <Text style={styles.item}>
                  {item.name}
                </Text>

                <Text style={styles.quantity}>
                  x{item.quantity}
                </Text>
              </View>
            ))
          )}
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}

function ShoppingListScreen() {
  const {
    items,
    toggleItem,
    removeItem,
  } = useShopping();

  return (
    <SafeAreaView style={styles.safe}>
      <ScrollView contentContainerStyle={styles.container}>
        <Text style={styles.title}>
          Alışveriş Listem 🛒
        </Text>

        <Text style={styles.subtitle}>
          Alınacak ürünlerini burada takip et.
        </Text>

        {items.length === 0 ? (
          <View style={styles.emptyBox}>
            <Text style={styles.emptyIcon}>🛒</Text>

            <Text style={styles.emptyTitle}>
              Listen boş
            </Text>

            <Text style={styles.emptyText}>
              Ürün Ekle sekmesinden ürün
              ekleyebilirsin.
            </Text>
          </View>
        ) : (
          items.map((item) => (
            <View
              style={styles.shoppingRow}
              key={item.id}
            >
              <TouchableOpacity
                style={[
                  styles.checkbox,
                  item.completed &&
                    styles.checkboxCompleted,
                ]}
                onPress={() =>
                  toggleItem(item.id)
                }
              >
                {item.completed && (
                  <Text style={styles.check}>
                    ✓
                  </Text>
                )}
              </TouchableOpacity>

              <View style={styles.shoppingInfo}>
                <Text
                  style={[
                    styles.shoppingName,
                    item.completed &&
                      styles.completedText,
                  ]}
                >
                  {item.name}
                </Text>

                <Text style={styles.shoppingQuantity}>
                  {item.quantity} {item.unit}
                </Text>
              </View>

              <TouchableOpacity
                onPress={() =>
                  removeItem(item.id)
                }
              >
                <Text style={styles.delete}>
                  🗑️
                </Text>
              </TouchableOpacity>
            </View>
          ))
        )}
      </ScrollView>
    </SafeAreaView>
  );
}

function AppTabs() {
  const { items } = useShopping();

  const activeCount = items.filter(
    (item) => !item.completed
  ).length;

  return (
    <Tab.Navigator
      screenOptions={{
        headerShown: false,
        tabBarActiveTintColor: "#394333",
        tabBarInactiveTintColor: "#999",
        tabBarStyle: {
          height: 70,
          paddingBottom: 10,
          paddingTop: 8,
        },
      }}
    >
      <Tab.Screen
        name="Ana Sayfa"
        component={HomeScreen}
        options={{
          tabBarIcon: ({ color }) => (
            <Text style={{ fontSize: 22 }}>
              🏠
            </Text>
          ),
        }}
      />

      <Tab.Screen
        name="Ürün Ekle"
        component={AddItemScreen}
        options={{
          tabBarIcon: ({ color }) => (
            <Text style={{ fontSize: 22 }}>
              ➕
            </Text>
          ),
        }}
      />

      <Tab.Screen
        name="Liste"
        component={ShoppingListScreen}
        options={{
          tabBarBadge:
            activeCount > 0
              ? activeCount
              : undefined,
          tabBarIcon: ({ color }) => (
            <Text style={{ fontSize: 22 }}>
              🛒
            </Text>
          ),
        }}
      />
    </Tab.Navigator>
  );
}

export default function App() {
  return (
    <ShoppingProvider>
      <NavigationContainer>
        <AppTabs />
      </NavigationContainer>
    </ShoppingProvider>
  );
}

